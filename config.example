# Copy to config.local (not tracked by git) and set your own path.
# Read by R/config.R; an NYC_TRAFFIC_DATA environment variable takes precedence.

# root of the data store (taxi/, crashes/, street_layout/, boundaries/, traffic_counts/, citibike/, ...)
NYC_TRAFFIC_DATA=/path/to/nyc_traffic_data

# street network history built by nyc_streets (default: nyc_streets_data next to the store)
NYC_STREETS_DATA=/path/to/nyc_streets_data
